# Standalone defaults for `python src/main.py`, i.e. running this component on
# its own with no deployment configuration mounted over it, or inside the
# Docker image. A deployment mounts its own config/ over this one and supplies
# the platform-wide `cltl.topic.*` names and the event bus.

[cltl.event]
implementation: internal

[cltl.backend]
# Where `cltl-storage:image/<id>` resolves, with the trailing slash. An image
# signal carries no pixels; the module fetches them from here and refuses to
# start on an empty or unexpanded value.
storage_url: $CLTL_STORAGE_URL
server_image_url: http://127.0.0.1:8000/host

[cltl.vlm_object_recognition]
model: Qwen3VL-8B-Instruct
host: http://localhost:9009
frequency_penalty: 0.3

[cltl.vlm_object_recognition.events]
image_topic: cltl.topic.image
object_topic: cltl.topic.object_recognition
